# labs/00_basics/ 下一律只收源码和脚本，编译产物全部由各目录的 check.sh 重建。
# 用白名单而不是逐个列举产物名：列举漏一个就会把二进制提交进去。
labs/00_basics/**/*
!labs/00_basics/**/
!labs/00_basics/**/*.c
!labs/00_basics/**/*.h
!labs/00_basics/**/*.sh
!labs/00_basics/**/*.md

